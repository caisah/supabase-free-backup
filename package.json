{
  "name": "db-backup",
  "version": "0.1.0",
  "private": true,
  "description": "Encrypted logical backups and restores for the project's Supabase databases",
  "type": "module",
  "scripts": {
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "node --test --test-skip-pattern=integration",
    "test:integration": "node --test --test-name-pattern=integration --test-concurrency=1",
    "check": "vp check && npm run test",
    "preflight": "node --input-type=module -e \"import('./src/runtime.js').then(m => m.assertNodeVersion())\"",
    "backup": "node scripts/backup.js",
    "backup:local": "node scripts/backup-local.js",
    "restore:development": "node scripts/restore-hosted.js development",
    "restore:production": "node scripts/restore-hosted.js production",
    "restore:local": "node scripts/restore-local.js",
    "reset:development": "node scripts/reset-hosted.js development",
    "reset:production": "node scripts/reset-hosted.js production",
    "reset:local": "node scripts/reset-local.js",
    "github:configure": "node scripts/configure-github.js",
    "commit:weekly": "node scripts/commit-weekly.js",
    "generate-age-keys": "node scripts/generate-age-keys.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "dotenv": "^17.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "supabase": "2.114.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.20.0"
  }
}
